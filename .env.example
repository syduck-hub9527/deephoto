# deephoto 配置示例。复制为 .env 后填写真实值;
# .env / .env.* 被 git 忽略,仅本示例可跟踪,请勿写入真实密钥。

# ---- 问答模型(Kimi K3,OpenAI 兼容;只负责问答,与图片描述无关)----
DEEPHOTO_MOONSHOT_API_KEY=
DEEPHOTO_MOONSHOT_BASE_URL=https://api.kimi.com/coding/v1
DEEPHOTO_CHAT_MODEL=k3
DEEPHOTO_CHAT_TEMPERATURE=1

# ---- 可选嵌入端点(任意 OpenAI 兼容;不配置则退化为纯关键词检索)----
DEEPHOTO_EMBEDDING_BASE_URL=
DEEPHOTO_EMBEDDING_MODEL=
DEEPHOTO_EMBEDDING_API_KEY=

# ---- MinerU 云端解析(唯一的 PDF 解析器,必填)----
DEEPHOTO_MINERU_API_KEY=

# ---- 图片描述模型(独立于以上三者;默认关闭,填写完整后改 true 启用)----
# Base URL 按控制台调用示例填到 /v1 为止,不要包含 /chat/completions
DEEPHOTO_DESCRIPTION_ENABLED=false
DEEPHOTO_DESCRIPTION_API_KEY=
DEEPHOTO_DESCRIPTION_BASE_URL=
DEEPHOTO_DESCRIPTION_MODEL=qwen3.8-omni-flash
DEEPHOTO_DESCRIPTION_REASONING_EFFORT=none
DEEPHOTO_DESCRIPTION_TIMEOUT_SECONDS=90
DEEPHOTO_DESCRIPTION_MAX_RETRIES=1
DEEPHOTO_DESCRIPTION_MAX_TOKENS=1024

# ---- 其他 ----
DEEPHOTO_DATA_DIR=./data
DEEPHOTO_MAX_UPLOAD_MB=100
DEEPHOTO_INGESTION_VERSION=v2
