# deephoto 配置示例。复制为 .env 后填写真实值;
# .env / .env.* 被 git 忽略,仅本示例可跟踪,请勿写入真实密钥。

# ---- 问答模型(Kimi K3,OpenAI 兼容;只负责问答,与图片描述无关)----
DEEPHOTO_MOONSHOT_API_KEY=
DEEPHOTO_MOONSHOT_BASE_URL=https://api.kimi.com/coding/v1
DEEPHOTO_CHAT_MODEL=k3
DEEPHOTO_CHAT_TEMPERATURE=1

# ---- 可选嵌入端点(OpenAI 兼容;不配置则退化为纯关键词检索)----
# 推荐 SiliconFlow 托管的 BAAI/bge-m3(稠密维度 1024,上下文 8192 tokens);
# Base URL 填到 /v1 为止,不要包含 /embeddings(客户端会自动拼接)。
# 切换模型后旧向量按版本隔离,需执行重建:python -m deephoto.indexing.reembed --dry-run
DEEPHOTO_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
DEEPHOTO_EMBEDDING_MODEL=BAAI/bge-m3
DEEPHOTO_EMBEDDING_API_KEY=
# 可选:显式声明期望维度(设定后启动探测维度必须相等,否则关闭向量)
#DEEPHOTO_EMBEDDING_DIM=1024
# 每批条数(1–32,SiliconFlow 单次数组上限)/ SDK 重试次数 / 单次超时秒数(>=5)
#DEEPHOTO_EMBEDDING_BATCH_SIZE=20
#DEEPHOTO_EMBEDDING_MAX_RETRIES=3
#DEEPHOTO_EMBEDDING_TIMEOUT_SECONDS=60

# ---- MinerU 云端解析(解析 PDF 必填;Markdown/纯文本走本地解析,不需要)----
DEEPHOTO_MINERU_API_KEY=

# ---- 图片描述模型(独立于以上三者;填写 API_KEY 与 BASE_URL 即自动启用,两项都留空则关闭)----
# 只填一半会在启动时报出缺失项。Base URL 按控制台调用示例填到 /v1 为止,不要包含 /chat/completions
DEEPHOTO_DESCRIPTION_API_KEY=
DEEPHOTO_DESCRIPTION_BASE_URL=
DEEPHOTO_DESCRIPTION_MODEL=qwen3.8-omni-flash
DEEPHOTO_DESCRIPTION_REASONING_EFFORT=none
DEEPHOTO_DESCRIPTION_TIMEOUT_SECONDS=90
DEEPHOTO_DESCRIPTION_MAX_RETRIES=1
DEEPHOTO_DESCRIPTION_MAX_TOKENS=1024

# ---- 其他 ----
DEEPHOTO_DATA_DIR=./data
DEEPHOTO_MAX_UPLOAD_MB=100
DEEPHOTO_INGESTION_VERSION=v2
# 上传格式白名单(逗号分隔;默认只开当前有可用引擎的 pdf/md/txt/docx)
DEEPHOTO_ALLOWED_FORMATS=pdf,md,txt,docx
# docx 解析引擎:local(python-docx 本地,默认)/ mineru(云端,耗额度,需 Token)
DEEPHOTO_DOCX_PARSER=local
# OOXML(zip)解压总量上限 MB(防压缩炸弹)
DEEPHOTO_MAX_ZIP_UNCOMPRESSED_MB=500
# Markdown 内联图(data URI)单张上限 MB
DEEPHOTO_MARKDOWN_DATA_URI_MAX_MB=10

# ---- 问答智能体增强 ----
# 已固定开启、无需配置:03 会话持久化(历史会话,仅单进程部署)、04 调用限制与工具轨迹、05 回答偏好记忆。
# 以下为仍可选的开关(默认关闭)。
# 01 委派模式:主智能体只做协调与撰写,检索/看图交给子智能体(总耗时约 3.6 倍,上线前先做 A/B)
DEEPHOTO_QA_SUBAGENTS_ENABLED=false
DEEPHOTO_QA_RETRIEVER_MAX_MODEL_CALLS=8
DEEPHOTO_QA_CHECKER_MAX_MODEL_CALLS=4
DEEPHOTO_QA_MAIN_RECURSION_LIMIT=40
# 02 知识库虚拟文件系统:智能体获得只读 /kb/(ls/read_file/glob/grep);改动后需重启进程
DEEPHOTO_QA_KB_VFS_ENABLED=false
DEEPHOTO_QA_KB_GREP_MAX_DOCS=300

# 04 调用限制(固定开启):主智能体单轮最多模型调用次数
DEEPHOTO_QA_MAIN_MAX_MODEL_CALLS=12

# 05 只读角色技能(可选)
DEEPHOTO_QA_SKILLS_ENABLED=false

# 06 HITL:inspect_image 人工审批闸门(可选)
# 每轮前 N 次看图自动放行,超出的暂停等待批准;0 = 每次都询问
DEEPHOTO_QA_HITL_ENABLED=false
DEEPHOTO_QA_HITL_AUTO_APPROVE_IMAGES=2
# 挂起超时秒数(>=30);超时后的下一次请求先按全部拒绝恢复,再处理新请求
DEEPHOTO_QA_HITL_TIMEOUT_SECONDS=600
